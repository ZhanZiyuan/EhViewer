-
-int
-strnatcmp(const char *a, const char *b)
-{
-    int result;
-
-    while (1) {
-         /* skip over leading spaces or zeros */
-          while (nat_isspace(a))
-               a++;
-
-          while (nat_isspace(b))
-               b++;
-
-          /* process run of digits */
-          if (nat_isdigit(a)  &&  nat_isdigit(b)) {
-               if ((result = compare_right(a, b)) != 0)
-                    return result;
-          }
-
-          if (!*a && !*b) {
-               /* The strings compare the same.  Perhaps the caller
