# The language bar describes product source, not build helpers or recorded fixtures.
# Keep syntax highlighting truthful; do not relabel supporting languages as Kotlin.
* linguist-detectable=false
*.kt linguist-detectable=true linguist-language=Kotlin
*.kts linguist-detectable=true linguist-language=Kotlin
*.rs linguist-detectable=true linguist-language=Rust

# Documentation and binary regression fixtures are not product source.
docs/** linguist-documentation=true
**/build/** linguist-generated=true
**/target/** linguist-generated=true

# Retain the exact audited upstream license bytes on every checkout platform.
app/desktop/licenses/** -text
# These two original MIT texts use CRLF; preserve and recognize their upstream line endings.
app/desktop/licenses/session/async-recursion-1.2.0/LICENSE-MIT whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
app/desktop/licenses/session/windows-native-keyring-store-1.1.0/LICENSE-MIT whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
